<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Glow Ring -->
    <path
        android:pathData="M54,30 A24,24 0 1,0 54,78 A24,24 0 1,0 54,30 Z"
        android:strokeWidth="4"
        android:strokeColor="#80A78BFA">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="78"
                android:type="linear">
                <item android:color="#33A78BFA" android:offset="0.0" />
                <item android:color="#1AEC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized Checkmark -->
    <path
        android:pathData="M38,54 L49,65 L70,44"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="44"
                android:endX="70"
                android:endY="65"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#A78BFA" android:offset="0.5" />
                <item android:color="#F43F5E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sparkle Star Accent -->
    <path
        android:pathData="M72,34 Q76,34 76,30 Q76,34 80,34 Q76,34 76,38 Q76,34 72,34 Z"
        android:fillColor="#FDE047" />
</vector>
